# Copier ce fichier en .env et renseigner de vraies valeurs.
# .env ne doit JAMAIS être commité/archivé (voir .gitignore).

# --- Kafka ---
KAFKA_PORT=9092

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_DB=hm_retail
POSTGRES_USER=hm_admin
POSTGRES_PASSWORD=change_me

# --- Spark ---
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

# --- n8n ---
N8N_PORT=5678

# --- Ollama (LLM local pour le chatbot RAG) ---
OLLAMA_PORT=11434

# --- Qdrant (base vectorielle pour le RAG) ---
QDRANT_PORT=6333
