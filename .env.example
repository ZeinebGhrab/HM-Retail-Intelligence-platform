# Copier en .env (jamais commité, voir .gitignore) avant le premier démarrage :
#   cp .env.example .env
#
# CHATBOT_APP_PORT et ML_TRAINING_PORT doivent rester différents : les deux
# services écoutent sur le port 8600 à l'intérieur de leur conteneur, donc
# sans ça docker-compose essaie de publier les deux sur le même port hôte.

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_DB=hm_retail
POSTGRES_USER=hm_admin
POSTGRES_PASSWORD=postgres

# --- Kafka ---
KAFKA_PORT=9092

# --- Spark ---
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

# --- n8n ---
N8N_PORT=5678

# --- Ollama ---
OLLAMA_PORT=11434

# --- Qdrant (exploratoire, voir backend/app/experiments/) ---
QDRANT_PORT=6333

# --- ML serving / training (voir ml/MLOPS_GUIDE.md) ---
ML_SERVING_PORT=8000
ML_TRAINING_PORT=8600
MLFLOW_PORT=5000

# --- Chatbot RAG (voir backend/app/README.md) ---
CHATBOT_APP_PORT=8601
