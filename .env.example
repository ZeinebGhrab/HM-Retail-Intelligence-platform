# Copier ce fichier en .env et renseigner de vraies valeurs.
# .env ne doit JAMAIS être commité/archivé (voir .gitignore).

# --- Kafka ---
KAFKA_PORT=9092

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_DB=hm_retail
POSTGRES_USER=hm_admin
POSTGRES_PASSWORD=change_me

# --- Spark ---
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

# --- n8n ---
N8N_PORT=5678

# --- Ollama (LLM local pour le chatbot RAG) ---
OLLAMA_PORT=11434

# --- Qdrant (base vectorielle pour le RAG) ---
QDRANT_PORT=6333

# --- MLflow (tracking d'expériences + Model Registry) ---
MLFLOW_PORT=5000
# Utilisé par ml/training/ et ml/serving/ hors Docker Compose (ex. poste de dev) :
MLFLOW_TRACKING_URI=http://localhost:5000

# --- ML Serving (API d'inférence FastAPI, voir ml/serving/ et ml/MLOPS_GUIDE.md) ---
ML_SERVING_PORT=8500
# POSTGRES_HOST : "localhost" pour les scripts ml/ lancés hors Docker (le port
# PostgreSQL est publié sur l'hôte, voir service postgres du docker-compose) ;
# le service ml-serving du docker-compose force automatiquement "postgres" en interne.
POSTGRES_HOST=localhost

# --- DagsHub (remote Git+DVC+MLflow combiné, voir ml/MLOPS_GUIDE.md §2) ---
# DAGSHUB_USER=
# DAGSHUB_TOKEN=
