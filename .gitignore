# Secrets
.env

# Données volumineuses (versionnées via DVC, pas via git — voir ARCHITECTURE.md)
data/raw/*.csv
data/raw/daily/*.csv
data/processed/*
data/features/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
# Pointeurs DVC (doivent être versionnés dans Git, contrairement aux vraies données ci-dessus)
!data/raw/*.dvc
!data/processed/*.dvc
!data/features/*.dvc
intermediate/

# Notebooks
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Modèles entraînés / artefacts MLflow
ml/models/*
!ml/models/.gitkeep
mlruns/

# Node (frontend)
node_modules/
frontend/dist/
frontend/build/

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# MLflow (tracking local / backend sqlite)
mlflow.db
mlflow_ci.db
ml/mlflow_fallback.db
mlflow_data/

# Rapports de monitoring générés (Evidently)
ml/monitoring/reports/*.html
!ml/monitoring/reports/.gitkeep

# DVC
/.dvc/cache
/.dvc/tmp