    {
      "parameters": {
        "jsCode": "const startDate = new Date('2026-07-10');\nconst offset = $getWorkflowStaticData('global').dayOffset || 0;\nconst simulatedDate = new Date(startDate);\nsimulatedDate.setDate(simulatedDate.getDate() + offset);\n$getWorkflowStaticData('global').dayOffset = offset + 1;\nreturn [{ json: { date: simulatedDate.toISOString().split('T')[0] } }];"
      },
      "id": "0240ecb3-aac8-42bc-ae33-5b586adeeba8",
      "name": "Calculer la date simulée",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://kafka-producer-api:8090/produce?date={{ $json.date }}",
        "options": {
          "timeout": 60000
        }
      },
