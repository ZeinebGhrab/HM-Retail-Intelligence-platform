      "id": "2ad3f0f5-ce9a-49b8-9d38-322305ab4eaf",
      "name": "Déclencheur - Ré-entraînement hebdomadaire (lundi 06:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
